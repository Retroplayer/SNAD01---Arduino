; RP2040 SNAD01 transaction engine. 1 MHz instruction clock.
; OUT/IN = DIO, SET = START, side-set = CLK (independent GPIOs).
; Header (shift left): writeCount-1:5, waitCount:5, readCount:5 (MSB first).
; Payload (shift left): output direction 1, then writeCount bits MSB first.
; Final FIFO word is an EXEC instruction: SET START high (normal) or low (sleep).
; Every transaction returns one RX word, including writes, as completion ACK.
.program snad01
.side_set 1
.wrap_target
    pull block          side 0
    out x, 5            side 0
    out y, 5            side 0
    out isr, 5          side 0
    set pins, 0         side 0 [4]
    pull block          side 0
    out pindirs, 1      side 0
write_bit:
    out pins, 1         side 0 [4]
    nop                 side 1 [4]
    jmp x-- write_bit   side 0 [4]
    mov osr, null       side 0
    out pindirs, 1      side 0
wait_test:
    jmp y-- wait_clock  side 0
    jmp read_setup      side 0
wait_clock:
    nop                 side 1 [4]
    jmp wait_test       side 0 [4]
read_setup:
    mov x, isr          side 0
    mov isr, null       side 0
read_test:
    jmp x-- read_bit    side 0
    jmp finish          side 0
read_bit:
    nop                 side 1 [4]
    nop                 side 0 [4]
    in pins, 1          side 0
    jmp read_test       side 0
finish:
    pull block          side 0
    out exec, 16        side 0 [4]
    push block          side 0
.wrap
